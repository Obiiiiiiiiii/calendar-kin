# Anthropic API key for the extraction/generation LLM calls
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
# KIN_MODEL=claude-opus-4-8
# KIN_TIMEZONE=America/New_York
# KIN_CALENDAR_ID=abc123...@group.calendar.google.com   # designate an exact calendar
# KIN_CALENDAR_NAME=Kin Life                            # fallback: find-or-create by name

# Only honored on models that still accept sampling parameters
# (current Opus models do not; grounding is carried by the prompts)
# KIN_EXTRACT_TEMPERATURE=0.2
# KIN_GENERATE_TEMPERATURE=0.7

# Web app (self-hosted; see README "Self-host on Railway")
# APP_PASSWORD=choose-a-password
# SECRET_KEY=random-string-keeps-logins-across-restarts
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=...
# DATA_DIR=/data

# Chat scanner (phase 2) — can also be entered in the web UI's Settings page
# KINDROID_API_KEY=kn_...
# KINDROID_AI_ID=...
# KIN_POLL_MINUTES=15        # poll rate while chat is active
# KIN_POLL_MAX_MINUTES=240   # backoff ceiling while chat is quiet
# KIN_MIN_CONFIDENCE=medium
