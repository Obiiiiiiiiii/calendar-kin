# Anthropic API key for the extraction/generation LLM calls
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
# KIN_MODEL=claude-opus-4-8
# KIN_TIMEZONE=America/New_York
# KIN_CALENDAR_NAME=Kin Life

# Only honored on models that still accept sampling parameters
# (current Opus models do not; grounding is carried by the prompts)
# KIN_EXTRACT_TEMPERATURE=0.2
# KIN_GENERATE_TEMPERATURE=0.7

# Phase 2 (reactive chat poller) — not used by the MVP
# KINDROID_API_KEY=kn_...
# KINDROID_AI_ID=...
